{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stream Agent knowledge pages",
  "description": "knowledge/urls.yaml: pages the agent's knowledge base is kept filled from, each a url or a mapping naming one.",
  "$comment": "Written by getstream agents init. Edits are overwritten.",
  "type": ["array", "null"],
  "items": {
    "oneOf": [
      {
        "type": "string",
        "pattern": "^https?://",
        "description": "The page's url."
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://",
            "description": "The page's url."
          },
          "title": {
            "type": "string",
            "description": "What the page is, for whoever reads the list."
          },
          "description": {
            "type": "string",
            "description": "What the page covers."
          }
        }
      }
    ]
  }
}
